{
  "name": "Gmart",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "_comment": "========== DEVELOPMENT ==========",
    "start": "expo start",
    "start:clean": "expo start -c",
    "web": "expo start --web",
    "web:clean": "expo start --web -c",
    "android": "expo start --android",
    "android:device": "expo run:android",
    "ios": "expo start --ios",
    "ios:device": "expo run:ios",
    "tunnel": "expo start --tunnel",
    "_comment2": "========== CACHE & RESET ==========",
    "clean": "expo start -c",
    "cache:clear": "npx expo start --clear",
    "reset": "npx expo start --clear && rm -rf node_modules/.cache",
    "reset:hard": "rm -rf node_modules package-lock.json && npm install && npx expo start -c",
    "_comment3": "========== BUILD (EAS) ==========",
    "build:preview": "eas build --platform android --profile preview",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:prod": "eas build --platform android --profile production",
    "build:prod:ios": "eas build --platform ios --profile production",
    "build:local": "eas build --platform android --profile preview --local",
    "_comment4": "========== SUBMIT (PUBLISH) ==========",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "_comment5": "========== UPDATE (OTA) ==========",
    "update": "eas update --branch production --message",
    "update:staging": "eas update --branch staging",
    "_comment6": "========== DOCTOR & DIAGNOSTICS ==========",
    "doctor": "npx expo-doctor",
    "doctor:fix": "npx expo-doctor --fix-dependencies",
    "lint": "npx tsc --noEmit",
    "install:pods": "cd ios && pod install",
    "_comment7": "========== AUTHENTICATION ==========",
    "login": "eas login",
    "logout": "eas logout",
    "whoami": "eas whoami"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@shopify/react-native-skia": "2.2.12",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.7.0",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "fuse.js": "^7.0.0",
    "lucide-react-native": "^0.460.0",
    "moti": "^0.29.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.0",
    "react-native": "0.81.5",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^3.0.0",
    "react-native-razorpay": "^2.3.1",
    "react-native-reanimated": "^4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
