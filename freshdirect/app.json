{
  "expo": {
    "name": "Gmart",
    "slug": "Gmart",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gmart",
    "userInterfaceStyle": "light",
    "backgroundColor": "#effeeb",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#effeeb"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chuchu.Gmart",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Gmart uses your location to set your delivery address.",
        "NSCameraUsageDescription": "Gmart uses the camera for profile photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#effeeb"
      },
      "package": "com.gmartfresh.app",
      "versionCode": 3,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Gmart to use your location."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b6905e08-88ee-4257-ae81-1d5b6318baf3"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6905e08-88ee-4257-ae81-1d5b6318baf3"
      }
    },
    "owner": "abhiroy"
  }
}
